# Shichida India Early Compass API: configuration
# Copy to .env for local development. On the server these live in the systemd env file
# (see deploy/README.md). Real environment variables take precedence over this file.

NODE_ENV=development
HOST=127.0.0.1
PORT=8090
# The path the app is served under on the shared site
BASE_PATH=/compass

# The site address parents open report links on, without a path (BASE_PATH is added).
# Local: http://localhost:5174 (the portal's dev server proxies /compass/r/ to this API)
PUBLIC_BASE_URL=http://localhost:5174

# 32+ random characters. Signs the report links sent to parents; changing it revokes them all.
# Required in production. Generate one with: openssl rand -base64 48
APP_SECRET=

# ---- AWS --------------------------------------------------------------------------
# dev = EarlyCompass-dev-* tables (local and staging), production = EarlyCompass-production-*
APP_ENV=dev
AWS_REGION=ap-south-1
# Locally: a named profile. On the server: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY instead.
AWS_PROFILE=shichida-setup
# Report PDFs, images and email previews. Leave empty to keep them under DATA_DIR on disk (development only).
S3_BUCKET=shichida-early-compass-dev-253264393609
DATA_DIR=storage

TIME_ZONE=Asia/Kolkata
SESSION_HOURS=12
REPORT_LINK_DAYS=30

# auto = secure cookies when PUBLIC_BASE_URL is https
COOKIE_SECURE=auto
# Proxies in front of the app, so client IPs (login throttling) are right: 2 behind CloudFront + nginx
TRUST_PROXY=false

# Centre names offered in the assessment form, comma-separated. Leave blank for free text.
CENTRES=

# Shown to parents in the PDF, the email and the report page
ORG_SUPPORT_EMAIL=
ORG_SUPPORT_PHONE=
ORG_WEBSITE=

# First administrator: created at start-up only when there are no staff accounts yet.
# Prefer: npm run user:create -- --email <email> --name "<name>" --role admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ---- Email ------------------------------------------------------------------------
# preview = nothing is sent, each email is saved as an .eml; ses = sent through Amazon SES; smtp = any SMTP server
EMAIL_MODE=preview
# A sender verified in SES (required for ses and smtp)
MAIL_FROM="Shichida India <noreply-test@shichidain.com>"
MAIL_REPLY_TO=
# SES configuration set for bounce and complaint tracking
SES_CONFIGURATION_SET=shichida-default
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---- WhatsApp Business Cloud API ------------------------------------------------
# Without these, "Send on WhatsApp" opens WhatsApp with the message and report link prefilled.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v23.0
# Approved template with a DOCUMENT header and body variables:
#   {{1}} parent name, {{2}} child's first name, {{3}} assessment date
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# ---- Internal system sync (optional) ----------------------------------------------
# Each finished assessment is POSTed here as signed JSON, including the PDF.
INTERNAL_WEBHOOK_URL=
INTERNAL_WEBHOOK_SECRET=
