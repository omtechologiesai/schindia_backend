# /etc/early-compass/staging.env (root-owned, mode 600). Read by early-compass-staging.service and
# by the staging workflow's table setup.
NODE_ENV=production
HOST=127.0.0.1
PORT=8091
BASE_PATH=/compass
PUBLIC_BASE_URL=https://staging.brainastra.com
# openssl rand -base64 48 — different from production's
APP_SECRET=

# dev tables and bucket, shared with local development
APP_ENV=dev
AWS_REGION=ap-south-1
# The early-compass-staging IAM user (deploy/iam-policy-staging.json)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=shichida-early-compass-dev-253264393609

EMAIL_MODE=ses
MAIL_FROM="Shichida India <noreply-test@shichidain.com>"
SES_CONFIGURATION_SET=shichida-default

# nginx only (staging isn't behind CloudFront)
TRUST_PROXY=1
TIME_ZONE=Asia/Kolkata
CENTRES=
ORG_SUPPORT_EMAIL=
ORG_SUPPORT_PHONE=
ORG_WEBSITE=
