{
  "name": "shichida-early-compass-api",
  "private": true,
  "version": "1.0.0",
  "description": "Shichida India Early Compass API: developmental assessments on DynamoDB, branded PDF reports on S3, parent sharing by email (SES) or WhatsApp. The staff portal lives in the Shichida frontend repo (early-compass/).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "build": "npm run typecheck && npm run build:bundle",
    "build:bundle": "esbuild server/index.ts scripts/db-setup.ts scripts/create-user.ts --bundle --platform=node --format=esm --target=node22 --packages=external --jsx=automatic --outdir=dist",
    "start": "NODE_ENV=production node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:setup": "tsx scripts/db-setup.ts",
    "user:create": "tsx scripts/create-user.ts",
    "sample:report": "tsx scripts/sample-report.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1132.0",
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/client-sesv2": "^3.1132.0",
    "@aws-sdk/lib-dynamodb": "^3.1132.0",
    "@react-pdf/renderer": "^4.9.0",
    "@resvg/resvg-js": "^2.6.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.10",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
