[Unit]
Description=Shichida Early Compass API (production, www.brainastra.com/compass)
After=network-online.target
Wants=network-online.target
# Skipped, not failed, until the first release exists (otherwise it would restart in a loop).
ConditionPathExists=/home/ubuntu/early-compass/dist/server/index.js

[Service]
User=ubuntu
# A symlink to the current release, switched by the "Early Compass → production" workflow
WorkingDirectory=/home/ubuntu/early-compass
EnvironmentFile=/etc/early-compass/production.env
Environment=NODE_OPTIONS=--max-old-space-size=320
ExecStart=/usr/bin/node dist/server/index.js
Restart=on-failure
RestartSec=3
# The server is shared with the admin app: a runaway report render must not starve it.
MemoryMax=450M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
