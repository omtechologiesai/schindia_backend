# /etc/early-compass/production.env (root-owned, mode 600). Read by early-compass.service and by
# the release workflow's table setup.
NODE_ENV=production
HOST=127.0.0.1
PORT=8090
BASE_PATH=/compass
PUBLIC_BASE_URL=https://www.brainastra.com
# openssl rand -base64 48 — different from staging's
APP_SECRET=

APP_ENV=production
AWS_REGION=ap-south-1
# The early-compass-production IAM user (deploy/iam-policy-production.json)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=shichida-early-compass-production-253264393609

EMAIL_MODE=ses
MAIL_FROM="Shichida India <noreply-test@shichidain.com>"
SES_CONFIGURATION_SET=shichida-default

# CloudFront, then nginx
TRUST_PROXY=2
TIME_ZONE=Asia/Kolkata
CENTRES=
ORG_SUPPORT_EMAIL=
ORG_SUPPORT_PHONE=
ORG_WEBSITE=
